<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Cyclone DDS 11.0.1 (ROS 2 Lyrical) port of ros2_rmw_benchmark configs/cyclonedds_shm.xml (main 7a774e8).
  Same loopback/discovery settings as cyclonedds_tuned.xml. Cyclone 0.10's <SharedMemory><Enable> is gone
  (the element has no children in 11.0): shared memory is now a PSMX plugin declared under
  General/Interfaces. psmx_iox (libpsmx_iox.so, shipped in ros-lyrical-cyclonedds) talks to iceoryx 2.0.6,
  so the iox-roudi daemon must run first (configs/iox_roudi_config.toml for the ring,
  configs/iox_roudi_perf.toml for performance_test and iRobot). LOG_LEVEL=warn matches the old <LogLevel>.
  Zero-copy only engages for fixed-size types (ring fixed mode, performance_test Array*, iRobot Stamped*).
-->
<CycloneDDS xmlns="https://cdds.io/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/11.0.1/etc/cyclonedds.xsd">
    <Domain id="any">
        <General>
            <Interfaces>
                <NetworkInterface name="lo" multicast="true"/>
                <PubSubMessageExchange type="iox" library="psmx_iox" config="LOG_LEVEL=warn;"/>
            </Interfaces>
            <AllowMulticast>spdp</AllowMulticast>
            <MaxMessageSize>65500B</MaxMessageSize>
        </General>
        <Discovery>
            <ParticipantIndex>none</ParticipantIndex>
        </Discovery>
    </Domain>
</CycloneDDS>
